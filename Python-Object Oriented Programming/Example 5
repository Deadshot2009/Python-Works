class BankAccount:
    def __init__(self,name,balance):
        self.name=name
        self.balance=balance
    def deposit(self,amount):
        self.amount=amount
        self.total_balance=self.amount+self.balance
    def display(self):
        print(self.name)
        print(self.total_balance)
obj1=BankAccount("Jeevaa",80000)
obj1.deposit(15000)
obj1.display()