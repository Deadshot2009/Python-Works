class GameCharacter:
    def __init__(self,name,health,coins):
        self.name=name
        self.health=health
        self.coins=coins
    def collect_coins(self,amount):
        self.coins+=amount
        print("Coins Collected")
    def take_damage(self,damage):
        self.health-=damage
        if self.health<=0:
            print("Game Over")
        else:
            print("Your Health Is Reduced")
    def heal(self,heal):
        self.health+=heal
        print("Health Stored")
    def display(self):
        print(self.name,self.health,self.coins)
obj1=GameCharacter("Jeevaa",50,150)
obj1.collect_coins(30)
obj1.take_damage(15)
obj1.heal(20)
obj1.display()
